{
  "fields": {
    "type": {
      "options": [
        "__APPEND__",
        "http"
      ]
    },
    "httpMethod": {
      "type": "enum",
      "options": [
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
        "GET"
      ],
      "default": "GET",
      "notStorable": true,
      "dataField": true,
      "prohibitedEmptyValue": true
    },
    "httpUrl": {
      "type": "varchar",
      "notStorable": true,
      "dataField": true
    },
    "httpBody": {
      "type": "text",
      "notStorable": true,
      "dataField": true,
      "useDisabledTextareaInViewMode": true
    },
    "httpOffset": {
      "type": "int",
      "notStorable": true,
      "dataField": true,
      "default": 0
    },
    "httpLimit": {
      "type": "int",
      "notStorable": true,
      "dataField": true,
      "default": 100
    },
    "httpTotal": {
      "type": "int",
      "notStorable": true,
      "dataField": true,
      "default": 2000
    },
    "importHttpHeaders": {
      "type": "linkMultiple",
      "layoutDetailDisabled": true,
      "layoutMassUpdateDisabled": true,
      "noLoad": true,
      "importDisabled": true
    }
  },
  "links": {
    "importHttpHeaders": {
      "type": "hasMany",
      "foreign": "importFeed",
      "entity": "ImportHttpHeader"
    }
  }
}